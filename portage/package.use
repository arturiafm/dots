# cpu
*/* CPU_FLAGS_X86: aes avx avx2 avx512_bitalg avx512_vbmi2 avx512_vnni
*/* CPU_FLAGS_X86: avx512_vp2intersect avx512_vpopcntdq avx512bw avx512cd
*/* CPU_FLAGS_X86: avx512dq avx512f avx512ifma avx512vbmi avx512vl bmi1 bmi2
*/* CPU_FLAGS_X86: f16c fma3 mmx mmxext pclmul popcnt rdrand sha sse sse2 sse3
*/* CPU_FLAGS_X86: sse4_1 sse4_2 ssse3 vpclmulqdq

# gpu
*/* VIDEO_CARDS: -* intel nvidia
*/* nvidia vdpau nvenc
x11-drivers/nvidia-drivers modules-sign

